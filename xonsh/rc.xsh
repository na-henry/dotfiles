# Starship prompt
execx($(starship init xonsh))

$XONSH_COLOR_STYLE = 'nord-darker'

# Aliases
aliases['lg'] = 'lazygit -ucd ~/.config/lazygit'
aliases['ld'] = 'lazydocker'
aliases['gd'] = 'gh dash'
aliases['t'] = 'tmux'
aliases['z'] = 'zellij'
aliases['n'] = 'nvim'
aliases['q'] = 'pi --print'
aliases['pir'] = 'pi --resume'
