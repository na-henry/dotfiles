;; Kanata configuration
;; Home-row mods are ALWAYS active on both hands.
;; Space held = arrows on the right hand + French accents on the QWERTY row;
;; Tab held = numpad on the right hand.
;; CapsLock is a plain Escape.
;; F-row = media by default (brightness / Mission Control / playback / volume),
;; because kanata's virtual keyboard isn't an Apple keyboard so macOS no longer
;; applies its own fn semantics. Hold fn for the real F1-F12 (fkeys layer).
;; Esc toggles the mods OFF into the `plain` layer (nothing is tap-hold there —
;; a/s/d/f and space are literal, so WASD and fast typing behave normally).
;; Tap Esc again to come back. Escape itself stays available on CapsLock.
;;
;; Why this feels instant while still giving you mods:
;;   tap-hold-release — release order still decides during typing:
;;     Release the home-row key first  => it was a letter.
;;     Release the OTHER key first     => it was a modifier.
;;     (Typing "do" you lift d before o; for Alt+O you hold d across o.
;;     Same-hand combos like Cmd+C on d+c work.)
;;     PLUS a timeout: holding the key alone past hold-timeout resolves to the
;;     modifier anyway. That is what makes mod+MOUSE-CLICK work — kanata never
;;     sees the mouse, so hold the key ~200ms, then click. The cost: long-
;;     pressing a home-row letter no longer auto-repeats it; tap then quickly
;;     re-press-and-hold (within tap-timeout) to repeat, or use the plain layer.
;;   require-prior-idle — a key typed just before a home-row key forces tap
;;     instantly, which absorbs fast rolls mid-word.
;;   hold-on-press lists — only the listed keys can pull Space/Tab into their
;;     layer. Rolling space into any other letter types that letter.
;;
;; Only remapped keys are declared in defsrc; everything else passes through
;; untouched (process-unmapped-keys keeps them visible to tap-hold decisions).
;;
;; macOS key names:
;;   lmet / rmet  = Command  (⌘)
;;   lalt / ralt  = Option   (⌥)
;;   lctl / rctl  = Control  (⌃)
;;   lsft / rsft  = Shift    (⇧)

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
)

(defvar
  tap-timeout  220 ;; tap-repress window: double-tap-hold within this ms = key repeat
  hold-timeout 200
  prior-idle   150 ;; a key pressed within this many ms => resolve as tap instantly
)

;; Hand assignment, required by tap-hold-opposite-hand.
;; Every key you might press WHILE holding a home-row mod must be listed here.
;; Unassigned keys default to `ignore`, which means the mod never resolves to a
;; hold -- that is what broke Ctrl+Backspace: bspc had no hand, so the Ctrl on
;; `a` silently stayed a letter. The editing/nav cluster is right-hand, so reach
;; for the LEFT mods (a s d f) when using Backspace, Delete, Enter or arrows.
(defhands
  (left  grv 1 2 3 4 5 esc tab q w e r t a s d f g z x c v b
         fn f1 f2 f3 f4 f5 f6)
  (right 6 7 8 9 0 - = y u i o p [ ] \ h j k l ; ' n m , . /
         bspc del ret up down left right home end pgup pgdn ins
         f7 f8 f9 f10 f11 f12)
)

;; Keys being remapped — everything else passes through untouched.
(defsrc
  esc  tab  caps a    s    d    f    h    j    k    l    ;    '    q    w    e    r    t    y    u    i    o    p    n    m    ,    .    spc
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)

(defalias
  ;; Esc : tap = drop to the plain layer (home-row mods off); tap again to return.
  ;; The inverse of a mods toggle: an escape hatch for gaming or heavy typing.
  esc      (layer-switch plain)
  esc-base (layer-switch base)

  ;; ── Home row mods, always on ────────────────────────────────────────────────
  ;; Left : a=Ctrl  s=Option  d=Command  f=Shift
  ;; Right: j=Shift k=Command l=Option   ;=Ctrl
  hrm-a     (tap-hold-release $tap-timeout $hold-timeout a lctl (require-prior-idle $prior-idle))
  hrm-s     (tap-hold-release $tap-timeout $hold-timeout s lalt (require-prior-idle $prior-idle))
  hrm-d     (tap-hold-release $tap-timeout $hold-timeout d lmet (require-prior-idle $prior-idle))
  hrm-f     (tap-hold-release $tap-timeout $hold-timeout f lsft (require-prior-idle $prior-idle))
  hrm-j     (tap-hold-release $tap-timeout $hold-timeout j rsft (require-prior-idle $prior-idle))
  hrm-k     (tap-hold-release $tap-timeout $hold-timeout k rmet (require-prior-idle $prior-idle))
  hrm-l     (tap-hold-release $tap-timeout $hold-timeout l ralt (require-prior-idle $prior-idle))
  hrm-scl   (tap-hold-release $tap-timeout $hold-timeout ; rctl (require-prior-idle $prior-idle))

  ;; ── French accents (nav layer, QWERTY row) ──────────────────────────────────
  ;;   q    w    e    r    t    y    u    i    o    p
  ;;   à    â    é    è    ê    ç    ù    î    ô    û
  agr (unicode à)
  acx (unicode â)
  eac (unicode é)
  egr (unicode è)
  ecx (unicode ê)
  ced (unicode ç)
  ugr (unicode ù)
  icx (unicode î)
  ocx (unicode ô)
  ucx (unicode û)

  ;; Space : tap = Space   hold = nav layer.
  ;; Only h/j/k/l (arrows), ' (enter) and the accent row (q..p)
  ;; can trigger the hold, so rolling space into any other letter still types it.
  spc (tap-hold-keys $tap-timeout $hold-timeout spc (layer-while-held nav)
        (hold-on-press q w e r t y u i o h j k l p ') (require-prior-idle $prior-idle))

  ;; fn : passes through (fn+arrows, globe tap keep working) AND holds the
  ;; fkeys layer, where the F-row is the literal F1-F12 instead of media.
  fn (multi fn (layer-while-held fkeys))

  ;; Tab : tap = Tab   hold = numpad layer, limited to the numpad keys.
  tab (tap-hold-keys $tap-timeout $hold-timeout tab (layer-while-held numpad)
        (hold-on-press u i o j k l m n , .) (require-prior-idle $prior-idle))
)

;; ── Base layer ───────────────────────────────────────────────────────────────
;; Home-row mods live here permanently. CapsLock = Escape.
;; F-row: F1 🔅  F2 🔆  F3 Mission Control  F7-F9 playback  F10-F12 sound.
;; F4/F5/F6 stay plain — kanata has no Spotlight/Dictation/DND outputs.
(deflayer base
  @esc @tab esc  @hrm-a @hrm-s @hrm-d @hrm-f _    @hrm-j @hrm-k @hrm-l @hrm-scl _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    @spc
  @fn  brdn brup mctl f4   f5   f6   prev pp   next mute vold volu
)

;; ── Nav layer (hold Space) ───────────────────────────────────────────────────
;; h=← j=↓ k=↑ l=→   '=Enter
;; QWERTY row = French accents: q=à w=â e=é r=è t=ê y=ç u=ù i=î o=ô p=û
;; a/s/d/f stay transparent, so the base home-row mods still work while held.
(deflayer nav
  _    _    _    _    _    _    _    left down up   right _    ret  @agr @acx @eac @egr @ecx @ced @ugr @icx @ocx @ucx _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
)

;; ── Numpad layer (hold Tab) ──────────────────────────────────────────────────
;;   u i o  =  7 8 9      j k l  =  4 5 6      m , .  =  1 2 3      n = 0
(deflayer numpad
  _    _    _    _    _    _    _    _    4    5    6    _    _    _    _    _    _    _    _    7    8    9    _    0    1    2    3    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
)

;; ── Fkeys layer (hold fn) ────────────────────────────────────────────────────
;; The F-row reverts to the literal function keys while fn is held.
(deflayer fkeys
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)

;; ── Plain layer (tap Esc to enter, Esc again to leave) ───────────────────────
;; No tap-hold anywhere: the home row, Space and Tab are all literal. Values are
;; written out rather than left transparent, because `_` would fall through to
;; base and bring the tap-hold behaviour back with it.
(deflayer plain
  @esc-base tab esc  a    s    d    f    _    j    k    l    ;    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    spc
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)
