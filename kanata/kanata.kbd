;; Kanata configuration — thumb mods, no tap-hold on letters
;; Alternatives kept for comparison: kanata-space-layer.kbd (mods + arrows both
;; under Space), kanata-opposite-hand.kbd (home-row mods on the letters).
;;
;; Every letter is a plain letter, always. Only two keys have a held role:
;;   Space    held = mods layer: home-row keys become plain modifiers
;;                   Left : a=Ctrl  s=Option  d=Command  f=Shift
;;                   Right: j=Shift k=Command l=Option   ;=Ctrl
;;                   Shortcut = Space + mod + key, e.g. Space+d+c = Cmd+C.
;;                   Once one hand holds a mod, the other hand's home row is
;;                   letters again: Space+j+a = A, Space+d+k = Cmd+K.
;;   CapsLock held = arrows layer: h=← j=↓ k=↑ l=→  '=Enter
;;                   a/s/d/f = the same left-hand mods (Caps+f+l = select →)
;;                   QWERTY row = French accents (q..p = à â é è ê ç ù î ô û)
;;            tap  = Escape
;; F-row = media by default, hold fn for F1-F12.
;; ISO swap: the key right of left Shift types ` and ~.
;;
;; Space decides by release order, like the home-row mods of the alternatives:
;;   another key pressed AND released while Space is down => mods layer
;;   Space released first (rolling into the next word)    => Space
;;   Space held alone past hold-timeout                   => mods layer, so
;;     Space+d (held) + mouse click = Cmd+click
;;   a key typed within prior-idle ms before Space        => Space, instantly
;; CapsLock switches to arrows on the first key pressed: it is never rolled
;; into from typing, so it can afford to be instant (and arrows auto-repeat
;; right away).
;;
;; macOS key names: lmet/rmet = ⌘  lalt/ralt = ⌥  lctl/rctl = ⌃  lsft/rsft = ⇧

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
)

(defvar
  tap-timeout  220
  hold-timeout 200 ;; Space held alone this long => mods layer
  prior-idle   150 ;; a key pressed within this many ms => Space is a tap
)

(defsrc
  caps a    s    d    f    h    j    k    l    ;    '    q    w    e    r    t    y    u    i    o    p    spc  grv  nubs
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)

(defalias
  ;; ── French accents (arrows layer, QWERTY row) ───────────────────────────────
  agr (unicode à)
  acx (unicode â)
  eac (unicode é)
  egr (unicode è)
  ecx (unicode ê)
  ced (unicode ç)
  ugr (unicode ù)
  icx (unicode î)
  ocx (unicode ô)
  ucx (unicode û)

  ;; Space : tap = Space   hold = mods layer (release-order decision).
  spc (tap-hold-release $tap-timeout $hold-timeout spc (layer-while-held mods)
        (require-prior-idle $prior-idle))

  ;; CapsLock : tap = Escape   hold = arrows layer, as soon as another key goes down.
  caps (tap-hold-press $tap-timeout $hold-timeout esc (layer-while-held arrows))

  fn (multi fn (layer-while-held fkeys))

  ;; ── One hand's mods turn the other hand's home row back into letters ───────
  ;; Holding a left mod (a/s/d/f) switches j/k/l/; to letters, and vice versa,
  ;; so Space+j+a = A and Space+d+k = Cmd+K. Same-hand stacking still works
  ;; (Space+d+f = Cmd+Shift); cross-hand mod combos are given up for this.
  ml-a (multi lctl (layer-while-held mods-left))
  ml-s (multi lalt (layer-while-held mods-left))
  ml-d (multi lmet (layer-while-held mods-left))
  ml-f (multi lsft (layer-while-held mods-left))
  mr-j (multi rsft (layer-while-held mods-right))
  mr-k (multi rmet (layer-while-held mods-right))
  mr-l (multi ralt (layer-while-held mods-right))
  mr-; (multi rctl (layer-while-held mods-right))
)

;; ── Base layer ───────────────────────────────────────────────────────────────
;; Plain letters everywhere. F-row: F1 🔅  F2 🔆  F3 Mission Control
;; F7-F9 playback  F10-F12 sound.
(deflayer base
  @caps _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    @spc nubs grv
  @fn   brdn brup mctl f4   f5   f6   prev pp   next mute vold volu
)

;; ── Mods layer (hold Space) ──────────────────────────────────────────────────
;; a=Ctrl s=Option d=Command f=Shift | j=Shift k=Command l=Option ;=Ctrl
(deflayer mods
  _     @ml-a @ml-s @ml-d @ml-f _   @mr-j @mr-k @mr-l @mr-; _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
)

;; Left mod held (on top of mods): left mods stay, right home row = letters.
(deflayer mods-left
  _     lctl lalt lmet lsft _    j    k    l    ;    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
)

;; Right mod held (on top of mods): right mods stay, left home row = letters.
(deflayer mods-right
  _     a    s    d    f    _    rsft rmet ralt rctl _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
)

;; ── Arrows layer (hold CapsLock) ─────────────────────────────────────────────
;; h=← j=↓ k=↑ l=→   '=Enter   QWERTY row = accents
;; a/s/d/f are the left-hand mods here too, so CapsLock alone covers editing:
;; Caps+f+h = Shift+← (select)   Caps+d+h = Cmd+← (line start)   Caps+s+h = Option+← (word)
(deflayer arrows
  _     lctl lalt lmet lsft left down up   right _    ret  @agr @acx @eac @egr @ecx @ced @ugr @icx @ocx @ucx _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
)

;; ── Fkeys layer (hold fn) ────────────────────────────────────────────────────
(deflayer fkeys
  _     _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)
