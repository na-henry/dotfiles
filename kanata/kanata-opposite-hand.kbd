;; Kanata configuration — ALTERNATIVE: opposite-hand home-row mods
;; Run instead of kanata.kbd:
;;   sudo kanata --cfg ~/Documents/dotfiles/kanata/kanata-opposite-hand.kbd
;;
;; Home-row mods live directly on the letters, decided by which hand presses
;; the next key:
;;   Left : a=Ctrl  s=Option  d=Command  f=Shift
;;   Right: j=Shift k=Command            ;=Ctrl   (l stays a plain letter:
;;          right Option went unused; s gives Option for right-hand keys)
;; Space held = arrows on the right hand + French accents on the QWERTY row.
;; Tab held = numpad on the right hand: u i o / j k l / m , . = 789 / 456 / 123, n = 0.
;; CapsLock is a plain Escape. F-row = media, hold fn for F1-F12.
;;
;; How a home-row key decides (tap-hold-opposite-hand-release):
;;   - next key on the SAME hand        => no decision yet, keep waiting; this
;;     is what lets mods stack (d+f held, tap o = Cmd+Shift+O)
;;   - next key on the OTHER hand, pressed AND released while the home-row key
;;     is still down                    => modifier (hold d, tap o = Cmd+O)
;;   - other-hand key pressed but the home-row key released first => letter
;;     (cross-hand rolls like "do", "ka": you lift d before o comes up)
;;   - Space follows the other-hand rule for BOTH hands: hold d, tap Space =
;;     Cmd+Space; "and " rolls stay letters because d comes up first
;;   - held alone past $hold-timeout    => modifier (mod + mouse click)
;;   - same-hand rolls ("sd", "as") stay letters because the first key comes
;;     up before any other-hand key is released
;;
;; Habits this asks for:
;;   - Shortcuts use the mod on the OPPOSITE hand: Cmd+C = k + c, Cmd+L = d + l.
;;     d + c types "dc".
;;   - Capitals: f for right-hand letters, j for left-hand letters.
;;   - Holding a home-row letter does not auto-repeat it.
;;
;; macOS key names: lmet/rmet = ⌘  lalt/ralt = ⌥  lctl/rctl = ⌃  lsft/rsft = ⇧

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
)

(defvar
  tap-timeout   220 ;; Space: tap-repress window
  hold-timeout  200 ;; index + middle fingers
  pinky-timeout 250 ;; ring + pinky lift later, give them more room
  scl-timeout   300 ;; ; taps are held longest (p95 ~240ms), keep them letters
  prior-idle    150 ;; Space only: a key pressed within this many ms => tap instantly
)

;; Every key you might press while holding a home-row mod needs a hand, or it
;; counts as unknown-hand. spc is left out: it is a neutral key (thumb, either
;; hand), configured per alias below.
(defhands
  (left  grv nubs 1 2 3 4 5 esc tab q w e r t a s d f g z x c v b
         fn f1 f2 f3 f4 f5 f6)
  (right 6 7 8 9 0 - = y u i o p [ ] \ h j k l ; ' n m , . /
         bspc del ret up down left right home end pgup pgdn ins
         f7 f8 f9 f10 f11 f12)
)

(defsrc
  caps a    s    d    f    h    j    k    l    ;    '    q    w    e    r    t    y    u    i    o    p    spc  grv  nubs
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  tab  n    m    ,    .
)

(defalias
  ;; Options shared by every home-row mod:
  ;;   timeout hold   — held alone long enough = modifier (needed for mod+click)
  ;;   same-hand ignore — same-hand keys don't decide; keep waiting for the
  ;;                    other hand, so d+f held + tap o = Cmd+Shift+O (stacks
  ;;                    up to a+s+d+f). Same-hand rolls stay letters through
  ;;                    the release rule: "sd" lifts s before anything else.
  ;;   no require-prior-idle — it would turn the second stacked mod, pressed
  ;;                    ~20ms after the first, into a letter.
  ;;   neutral spc hold — Space counts as the OPPOSITE hand for both sides:
  ;;                    hold d or k, tap Space = Cmd+Space. Same release rule:
  ;;                    lift d before Space comes up ("and ") and it's a letter.
  ;;   unknown-hand tap — keys missing from defhands fail safe to letters.
  hrm-a   (tap-hold-opposite-hand-release $pinky-timeout a lctl
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))
  hrm-s   (tap-hold-opposite-hand-release $pinky-timeout s lalt
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))
  hrm-d   (tap-hold-opposite-hand-release $hold-timeout d lmet
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))
  hrm-f   (tap-hold-opposite-hand-release $hold-timeout f lsft
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))
  hrm-j   (tap-hold-opposite-hand-release $hold-timeout j rsft
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))
  hrm-k   (tap-hold-opposite-hand-release $hold-timeout k rmet
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))
  hrm-scl (tap-hold-opposite-hand-release $scl-timeout ; rctl
            (timeout hold) (same-hand ignore) (neutral-keys spc) (neutral hold)
            (unknown-hand tap))

  ;; ── French accents (nav layer, QWERTY row) ──────────────────────────────────
  ;;   q    w    e    r    t    y    u    i    o    p
  ;;   à    â    é    è    ê    ç    ù    î    ô    û
  agr (unicode à)
  acx (unicode â)
  eac (unicode é)
  egr (unicode è)
  ecx (unicode ê)
  ced (unicode ç)
  ugr (unicode ù)
  icx (unicode î)
  ocx (unicode ô)
  ucx (unicode û)

  ;; Space : tap = Space   hold = nav layer (arrows + accents).
  ;; Same release rule as the home-row mods: nav engages only if another key
  ;; goes down AND up while Space is held, or Space is held past hold-timeout.
  ;; Rolling Space into the next word releases Space first, so it stays Space.
  ;; a/s/d/f stay home-row mods inside nav, so Space, then d, then h = Cmd+←.
  spc (tap-hold-release $tap-timeout $hold-timeout spc (layer-while-held nav)
        (require-prior-idle $prior-idle))

  ;; Tab : tap = Tab   hold = numpad layer. Same release rule as Space, but no
  ;; prior-idle: Tab right after typing (shell completion) is released before
  ;; the next key comes up, so it stays Tab.
  tab (tap-hold-release $tap-timeout $hold-timeout tab (layer-while-held numpad))

  fn (multi fn (layer-while-held fkeys))
)

;; ── Base layer ───────────────────────────────────────────────────────────────
;; ISO swap: the key right of left Shift types ` and ~ (grv); the key left of
;; 1 takes its old character (§ ±) in exchange.
(deflayer base
  esc  @hrm-a @hrm-s @hrm-d @hrm-f _    @hrm-j @hrm-k _      @hrm-scl _    _    _    _    _    _    _    _    _    _    _    @spc nubs grv
  @fn  brdn brup mctl f4   f5   f6   prev pp   next mute vold volu
  @tab _    _    _    _
)

;; ── Nav layer (hold Space) ───────────────────────────────────────────────────
;; h=← j=↓ k=↑ l=→   '=Enter   QWERTY row = accents
(deflayer nav
  _    _    _    _    _    left down up   right _    ret  @agr @acx @eac @egr @ecx @ced @ugr @icx @ocx @ucx _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _
)

;; ── Numpad layer (hold Tab) ──────────────────────────────────────────────────
;;   u i o   7 8 9
;;   j k l   4 5 6
;;   m , .   1 2 3
;;   n       0
;; a/s/d/f stay home-row mods; the right-hand mods give way to digits.
(deflayer numpad
  _    _    _    _    _    _    4    5    6    _    _    _    _    _    _    _    _    7    8    9    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    0    1    2    3
)

;; ── Fkeys layer (hold fn) ────────────────────────────────────────────────────
(deflayer fkeys
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _  _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    _    _    _
)
