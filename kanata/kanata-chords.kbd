;; Kanata configuration — ALTERNATIVE: chord mods on the home row
;; Run instead of kanata.kbd:
;;   sudo kanata --cfg ~/Documents/dotfiles/kanata/kanata-chords.kbd
;;
;; The home row types plain letters, with no hold-to-decide delay. Modifiers
;; come from pressing home-row keys together
;; (40ms for 2 keys, 60ms for 3, 75ms for 4) and stay held while the chord is held:
;;   Left : d+f = Command   s+d = Option   a+s = Control
;;   Right: j+k = Command   k+l = Option   l+; = Control
;;   Stacks: s+d+f / j+k+l = Option+Command   a+s+d / k+l+; = Control+Option
;;           a+d+f / j+k+; = Control+Command  a+s+d+f / j+k+l+; = all three
;; Shift is the physical Shift keys, and both Command keys are Shift too.
;; CapsLock: tap = Escape, hold = arrows on the right hand + French accents
;; on the QWERTY row.
;; Tab held = numpad on the right hand:
;;   u i o / j k l / m , . = 789 / 456 / 123, n = 0.
;; Space is a plain Space. F-row = media, hold fn for F1-F12.
;;
;; Shortcuts: chord on one hand, key on the other: Cmd+C = j+k then c,
;; Cmd+L = d+f then l. Mod + click: hold the chord and click.
;; A chord key waits for its partner only until the next key comes (at most
;; the chord window); typing logs showed home-row pairs never typed this close.
;;
;; macOS key names: lmet/rmet = ⌘  lalt/ralt = ⌥  lctl/rctl = ⌃  lsft/rsft = ⇧

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes ;; required by defchordsv2
)

(defvar
  tap-timeout   220 ;; Tab / CapsLock: tap-repress window
  hold-timeout  200 ;; Tab / CapsLock: held alone this long => layer
  ;; The keyboard reports keys in ~15ms steps, so N keys pressed "at once"
  ;; spread over (N-1)*15ms: 4-key chords landed 43–46ms apart. Typing pairs
  ;; were never under 40ms.
  chord-timeout  40 ;; 2 keys
  chord3-timeout 60 ;; 3 keys
  chord4-timeout 75 ;; 4 keys
)

;; The right-hand chords are off in nav and numpad, where j k l are arrows
;; and digits (typing "45" fast must not become Command).
(defchordsv2
  (d f)       lmet                      $chord-timeout first-release ()
  (s d)       lalt                      $chord-timeout first-release ()
  (a s)       lctl                      $chord-timeout first-release ()
  (s d f)     (multi lalt lmet)         $chord3-timeout first-release ()
  (a s d)     (multi lctl lalt)         $chord3-timeout first-release ()
  (a d f)     (multi lctl lmet)         $chord3-timeout first-release ()
  (a s d f)   (multi lctl lalt lmet)    $chord4-timeout first-release ()
  (j k)       rmet                      $chord-timeout first-release (nav numpad)
  (k l)       ralt                      $chord-timeout first-release (nav numpad)
  (l ;)       rctl                      $chord-timeout first-release (nav numpad)
  (j k l)     (multi rmet ralt)         $chord3-timeout first-release (nav numpad)
  (k l ;)     (multi ralt rctl)         $chord3-timeout first-release (nav numpad)
  (j k ;)     (multi rmet rctl)         $chord3-timeout first-release (nav numpad)
  (j k l ;)   (multi rmet ralt rctl)    $chord4-timeout first-release (nav numpad)
)

(defsrc
  caps a    s    d    f    h    j    k    l    ;    '    q    w    e    r    t    y    u    i    o    p    tab  grv  nubs
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  lmet n    m    ,    .    rmet
)

(defalias
  ;; ── French accents (nav layer, QWERTY row) ──────────────────────────────────
  ;;   q    w    e    r    t    y    u    i    o    p
  ;;   à    â    é    è    ê    ç    ù    î    ô    û
  agr (unicode à)
  acx (unicode â)
  eac (unicode é)
  egr (unicode è)
  ecx (unicode ê)
  ced (unicode ç)
  ugr (unicode ù)
  icx (unicode î)
  ocx (unicode ô)
  ucx (unicode û)

  ;; CapsLock : tap = Escape   hold = nav layer (arrows + accents).
  ;; nav engages only if another key goes down AND up while CapsLock is held,
  ;; or CapsLock is held past hold-timeout. Escape right after typing (vim)
  ;; is released before the next key comes up, so it stays Escape.
  ;; Left-hand chords still work inside nav: CapsLock, then d+f, then h = Cmd+←.
  caps (tap-hold-release $tap-timeout $hold-timeout esc (layer-while-held nav))

  ;; Tab : tap = Tab   hold = numpad layer. Same release rule as CapsLock:
  ;; Tab right after typing (shell completion) is released before the next
  ;; key comes up, so it stays Tab.
  tab (tap-hold-release $tap-timeout $hold-timeout tab (layer-while-held numpad))

  fn (multi fn (layer-while-held fkeys))
)

;; ── Base layer ───────────────────────────────────────────────────────────────
;; ISO swap: the key right of left Shift types ` and ~ (grv); the key left of
;; 1 takes its old character (§ ±) in exchange. Both Command keys are Shift;
;; Command comes from the chords.
(deflayer base
  @caps _   _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    @tab nubs grv
  @fn  brdn brup mctl f4   f5   f6   prev pp   next mute vold volu
  lsft _    _    _    _    rsft
)

;; ── Nav layer (hold CapsLock) ────────────────────────────────────────────────
;; h=← j=↓ k=↑ l=→   '=Enter   QWERTY row = accents
(deflayer nav
  _    _    _    _    _    left down up   right _    ret  @agr @acx @eac @egr @ecx @ced @ugr @icx @ocx @ucx _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _
)

;; ── Numpad layer (hold Tab) ──────────────────────────────────────────────────────
;;   u i o   7 8 9
;;   j k l   4 5 6
;;   m , .   1 2 3
;;   n       0
;; Left-hand chords still give mods here.
(deflayer numpad
  _    _    _    _    _    _    4    5    6    _    _    _    _    _    _    _    _    7    8    9    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    0    1    2    3    _
)

;; ── Fkeys layer (hold fn) ────────────────────────────────────────────────────
(deflayer fkeys
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _  _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    _    _    _    _
)
