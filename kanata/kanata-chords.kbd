;; Kanata configuration — ALTERNATIVE: home-row mods behind Space
;; Run instead of kanata.kbd:
;;   sudo kanata --cfg ~/Documents/dotfiles/kanata/kanata-chords.kbd
;;
;; The home row types plain letters, with no hold-to-decide delay, unless
;; Space or CapsLock is held.
;; Command keys: tap = switch keyboard layout (sends F18, Vorssaint's Super Key
;; tap), hold = Shift. The Shift keys type Command.
;; Space: tap = Space, hold = mods: the whole home row turns into opposite-hand
;; mods  a s d f = Control Option Command Shift   j k l ; = Shift Command Option Control
;;   A home-row key is a mod only when a key on the OTHER hand is pressed AND
;;   released while it is down (Space, d, c = Cmd+C), or when it is held alone
;;   past the timeout (mod + click). Same-hand keys keep it waiting, so mods
;;   stack (Space, d+f, o = Cmd+Shift+O). Lifted first, it types its letter.
;; CapsLock: tap = Escape, hold = nav: arrows on the right hand, one-key mods on
;; the left (a s d f = Control Option Command Shift) + French accents on the
;; QWERTY row.
;; Tab held = numpad on the right hand:
;;   u i o / j k l / m , . = 789 / 456 / 123, n = 0.
;; F-row = media, hold fn for F1-F12.
;;
;; macOS key names: lmet/rmet = ⌘  lalt/ralt = ⌥  lctl/rctl = ⌃  lsft/rsft = ⇧

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
)

(defvar
  tap-timeout   220 ;; Tab / CapsLock: tap-repress window
  hold-timeout  200 ;; Tab / CapsLock: held alone this long => layer;
                    ;; index + middle mods in the Space layer
  pinky-timeout 250 ;; ring + pinky mods in the Space layer lift later
)

;; Hands for the opposite-hand mods in the Space layer. Space and the
;; Command keys (layout / Shift) are thumb keys: they count as the other hand
;; for both sides. Keys missing here type
;; their letter.
(defhands
  (left  grv nubs 1 2 3 4 5 esc tab caps q w e r t a s d f g z x c v b
         fn f1 f2 f3 f4 f5 f6)
  (right 6 7 8 9 0 - = y u i o p [ ] \ h j k l ; ' n m , . /
         bspc del ret up down left right home end pgup pgdn ins
         f7 f8 f9 f10 f11 f12)
)

(defsrc
  caps a    s    d    f    h    j    k    l    ;    '    q    w    e    r    t    y    u    i    o    p    tab  grv  nubs
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  lmet n    m    ,    .    rmet lsft rsft spc
)

(defalias
  ;; ── Opposite-hand mods (Space layer) ─────────────────────────────────────────
  ohm-a (tap-hold-opposite-hand-release $pinky-timeout a lctl
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-s (tap-hold-opposite-hand-release $pinky-timeout s lalt
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-d (tap-hold-opposite-hand-release $hold-timeout d lmet
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-f (tap-hold-opposite-hand-release $hold-timeout f lsft
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-j (tap-hold-opposite-hand-release $hold-timeout j rsft
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-k (tap-hold-opposite-hand-release $hold-timeout k rmet
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-l (tap-hold-opposite-hand-release $pinky-timeout l ralt
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))
  ohm-scl (tap-hold-opposite-hand-release $pinky-timeout ; rctl
            (timeout hold) (same-hand ignore) (neutral-keys spc lmet rmet) (neutral hold)
            (unknown-hand tap))

  ;; ── French accents (nav layer, QWERTY row) ──────────────────────────────────
  ;;   q    w    e    r    t    y    u    i    o    p
  ;;   à    â    é    è    ê    ç    ù    î    ô    û
  agr (unicode à)
  acx (unicode â)
  eac (unicode é)
  egr (unicode è)
  ecx (unicode ê)
  ced (unicode ç)
  ugr (unicode ù)
  icx (unicode î)
  ocx (unicode ô)
  ucx (unicode û)

  ;; CapsLock : tap = Escape   hold = nav layer (arrows + accents).
  ;; nav engages only if another key goes down AND up while CapsLock is held,
  ;; or CapsLock is held past hold-timeout. Escape right after typing (vim)
  ;; is released before the next key comes up, so it stays Escape.
  ;; Inside nav, a s d f are plain mods: CapsLock, then d, then h = Cmd+←.
  caps (tap-hold-release $tap-timeout $hold-timeout esc (layer-while-held nav))

  ;; Tab : tap = Tab   hold = numpad layer. Same release rule as CapsLock:
  ;; Tab right after typing (shell completion) is released before the next
  ;; key comes up, so it stays Tab.
  tab (tap-hold-release $tap-timeout $hold-timeout tab (layer-while-held numpad))

  ;; Space : tap = Space   hold = mods layer, same release rule as CapsLock.
  ;; A space rolled into the next word is released before that letter comes
  ;; up, so it stays Space.
  spc (tap-hold-release $tap-timeout $hold-timeout spc (layer-while-held mods))

  ;; Command keys : tap = switch layout   hold = Shift. Shift engages once
  ;; another key goes down AND up while held: hold Command, type the letter,
  ;; let go. Releasing Command before the letter comes up switches the layout.
  ;; The tap sends F18: Vorssaint's Super Key listens for F18 (the key it maps
  ;; Caps Lock to) and, tapped alone with "Switch input source" as its solo
  ;; action, moves to the next layout.
  lcmd (tap-hold-release $tap-timeout $hold-timeout f18 lsft)
  rcmd (tap-hold-release $tap-timeout $hold-timeout f18 rsft)

  fn (multi fn (layer-while-held fkeys))
)

;; ── Base layer ───────────────────────────────────────────────────────────────
;; ISO swap: the key right of left Shift types ` and ~ (grv); the key left of
;; 1 takes its old character (§ ±) in exchange. The Command keys tap to switch
;; layout and hold Shift; the Shift keys type Command.
(deflayer base
  @caps _   _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    @tab nubs grv
  @fn  brdn brup mctl f4   f5   f6   prev pp   next mute vold volu
  @lcmd _   _    _    _    @rcmd lmet rmet @spc
)

;; ── Nav layer (hold CapsLock) ────────────────────────────────────────────────
;; a=⌃ s=⌥ d=⌘ f=⇧   h=← j=↓ k=↑ l=→   '=Enter   QWERTY row = accents
(deflayer nav
  _    lctl lalt lmet lsft left down up   right _    ret  @agr @acx @eac @egr @ecx @ced @ugr @icx @ocx @ucx _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _
)

;; ── Mods layer (hold Space) ──────────────────────────────────────────────────
;; a=⌃ s=⌥ d=⌘ f=⇧   j=⇧ k=⌘ l=⌥ ;=⌃, opposite-hand rule (see the top).
;; Space, then d, then c = Cmd+C.
(deflayer mods
  _    @ohm-a @ohm-s @ohm-d @ohm-f _ @ohm-j @ohm-k @ohm-l @ohm-scl _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _
)

;; ── Numpad layer (hold Tab) ──────────────────────────────────────────────────────
;;   u i o   7 8 9
;;   j k l   4 5 6
;;   m , .   1 2 3
;;   n       0
(deflayer numpad
  _    _    _    _    _    _    4    5    6    _    _    _    _    _    _    _    _    7    8    9    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    0    1    2    3    _    _    _    _
)

;; ── Fkeys layer (hold fn) ────────────────────────────────────────────────────
(deflayer fkeys
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _  _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    _    _    _    _    _    _    _
)
